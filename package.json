{
  "name": "bengali-study-bible",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:integrity": "node scripts/verify-bible-integrity.mjs",
    "test:install-qr": "node scripts/test-permanent-install-suite.mjs",
    "test:bible": "node scripts/verify-scripture-checksums.mjs && node scripts/verify-bible-integrity.mjs && node scripts/test-matthew-ot-nt-audit.mjs && npx tsx scripts/test-bibleservice-runtime.ts",
    "guard": "npm run test:install-qr && npm run test:bible && npm run build",
    "deploy:prep": "node scripts/prepare-deploy.mjs",
    "deploy:surge": "node scripts/deploy-production.mjs --publish",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "rollback": "node scripts/rollback-production.mjs",
    "monitor:uptime": "node scripts/deep-external-uptime-monitor.mjs --once",
    "autopilot:check": "node scripts/deep-autopilot-health-runner.mjs --once",
    "autopilot:start": "node scripts/deep-autopilot-health-runner.mjs --daemon",
    "monitor:15min": "node scripts/deep-15min-monitor.mjs --once",
    "monitor:daemon": "node scripts/deep-15min-monitor.mjs --daemon",
    "monitor:report": "node scripts/deep-15min-monitor.mjs --report",
    "test:autopilot": "node scripts/test-autopilot-activation-suite.mjs",
    "test:recovery": "node scripts/test-emergency-recovery-console-suite.mjs",
    "test:parity": "node scripts/test-deep-lexi-parity-suite.mjs",
    "test:visibility": "node scripts/test-visibility-and-viewport-matrix.mjs",
    "watchdog": "node scripts/deep-independent-watchdog.mjs",
    "test:protection": "node scripts/test-final-independent-protection-system.mjs",
    "monitor:observe": "node scripts/observe-site.mjs",
    "test:monitor": "node --test scripts/test-observation-rules.mjs",
    "test:usfm": "node scripts/verify-usfm-comparison.mjs",
    "deploy:publish": "node scripts/deploy-production.mjs --publish",
    "test:ask": "node --import ./scripts/register-test-loader.mjs scripts/test-ask-bible.mjs",
    "test:ranges": "node --test scripts/test-verse-ranges.mjs && node scripts/audit-verse-ranges.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsqr": "^1.4.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
